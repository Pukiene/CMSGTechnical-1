@using CMSGTechnical.Code
@using CMSGTechnical.Mediator.Dtos
@using System.Globalization
@implements IDisposable


<div class="basket">
    @if (BasketService?.Basket?.MenuItems is null || BasketService.Basket.MenuItems.Count == 0)
    {
        <div class="p-3 text-white-50">Basket is empty</div>
    }
    else
    {
        @foreach (var item in BasketService.Basket.MenuItems.OrderBy(x => x.Name))
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="text-white">
                    <div class="fw-bold">@item.Name</div>
                    <div class="text-white-50">
                        <span class="badge bg-danger me-2">@Math.Max(1, item.Quantity)</span>
                        <span>x @item.Price.ToString("C", Gb)</span>
                        <span class="ms-2">= <strong class="text-white">@((item.Price * Math.Max(1, item.Quantity)).ToString("C", Gb))</strong></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-round" @onclick="async () => await Remove(item)">-</button>
                    <button class="btn btn-primary btn-round" @onclick="async () => await Add(item)">+</button>
                </div>
            </div>
        }

        <div class="mt-3 text-white">
            <div>Delivery: @DeliveryFee.ToString("C", Gb)</div>
            <div><strong>Total: @Total.ToString("C", Gb)</strong></div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Gb = CultureInfo.GetCultureInfo("en-GB");
    private const decimal DeliveryFee = 2.00m;

    [CascadingParameter] public BasketService BasketService { get; set; } = default!;

    private decimal ItemsTotal => BasketService.Basket.MenuItems.Sum(i => i.Price * Math.Max(1, i.Quantity));
    private decimal Total => ItemsTotal + DeliveryFee;

    protected override void OnInitialized()
    {
        BasketService.OnChange += BasketChanged;
    }

    private void BasketChanged(object? sender, BasketChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        BasketService.OnChange -= BasketChanged;
    }

    private Task Add(MenuItemDto item) => BasketService.Add(item);
    private Task Remove(MenuItemDto item) => BasketService.Remove(item);
}
