@page "/"
@using CMSGTechnical.Code
@using CMSGTechnical.Domain.Models
@using CMSGTechnical.Mediator.Menu
@using MediatR
@using CMSGTechnical.Components.Shared
@using CMSGTechnical.Mediator.Dtos

<PageTitle>Home</PageTitle>

@foreach (var group in MenuItems
    .Select(x =>
    {
        x.Category = string.IsNullOrWhiteSpace(x.Category) ? "Main" : x.Category;
        return x;
    })
    .GroupBy(x => x.Category)
    .OrderBy(g => CategorySortKey(g.Key)))
{
    <h5 class="mt-4 mb-2">@group.Key</h5>

    @foreach (var item in group.OrderBy(x => x.Price).ThenBy(x => x.Name))
    {
        <MenuItemDisplay Item="@item" OnAdd="() => AddItem(item.Id)" />
    }
}


@code
{
    [Inject] private IMediator Mediator { get; set; } = default!;

    private MenuItemDto[] MenuItems { get; set; } = Array.Empty<MenuItemDto>();

    [CascadingParameter] private BasketService Basket { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        MenuItems = (await Mediator.Send(new GetMenuItems())).ToArray();
    }

    private async Task AddItem(int id)
    {
        var menuItem = MenuItems.First(i => i.Id == id);
        await Basket.Add(menuItem);
    }

    private static int CategorySortKey(string? category) => category switch
    {
        "Starter" => 0,
        "Main" => 1,
        "Dessert" => 2,
        _ => 99
    };
}
